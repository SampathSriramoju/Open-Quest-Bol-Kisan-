# Bol Kisan Backend Environment Configuration
ENV=development
DATABASE_URL=sqlite:///./bol_kisan_server.db
USE_PGVECTOR=false

# Online LLM Settings (Free API Keys)
# Supported Providers: "gemini", "openrouter", "groq", or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Default model: gemini-3.8-flash (free tier in Google AI Studio)
# Alternative light model: gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash

# OpenRouter Free Models (https://openrouter.ai/keys)
# Verified $0 free-tier models ending with :free
OPENROUTER_API_KEY=
# High-Reasoning Candidate (550B MoE):
OPENROUTER_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
# Multimodal / Vision Candidate:
OPENROUTER_VISION_MODEL_ID=nvidia/nemotron-3.5-super-vl:free
# Google Gemma 4 26B Candidate:
GEMMA_FREE_MODEL_ID=google/gemma-4-26b-a4b-it:free

# Groq API Key (https://console.groq.com/keys)
# Alternative fast model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Strict Zero-Cost & Quota Protection Limits
STRICT_ZERO_COST_ENFORCEMENT=true

# Latency and Quota Protection Limits
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_OUTPUT_TOKENS=350
