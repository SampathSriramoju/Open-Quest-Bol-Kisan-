# Bol Kisan Backend Environment Configuration
ENV=development
DATABASE_URL=sqlite:///./bol_kisan_server.db
USE_PGVECTOR=false

# Online LLM Settings (Free API Keys)
# Supported Providers: "gemini", "groq", or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Default model: gemini-2.5-flash (free tier)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Groq API Key (https://console.groq.com/keys)
# Alternative fast model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Latency and Quota Protection Limits
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_OUTPUT_TOKENS=350
